<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox 
        spacing="15" 
        alignment="CENTER" 
        style="-fx-padding: 20;" 
        xmlns="http://javafx.com/javafx/21" 
        xmlns:fx="http://javafx.com/fxml/1" 
        fx:controller="controller.PrincipalController">
    
    <Label 
            text="Compra en Cafetería" />
    
    <Label 
            text="Cliente:" />
    
    <TextField 
            fx:id="txtCliente" />
    
    <Label 
            text="Bebida:" />
    
    <ComboBox 
            fx:id="cbBebida" />
    
    <Label 
            text="Cantidad:" />
    
    <TextField 
            fx:id="txtCantidad" 
            onKeyPressed="#manejarKeyEvent" />
    
    <CheckBox 
            fx:id="chkPostre" 
            text="Agregar postre (RD$ 75.00)" />
    
    <Button 
            fx:id="btnCalcular" 
            text="Calcular" 
            onAction="#calcular" 
            onMouseEntered="#mouseEntraBoton" 
            onMouseExited="#mouseSaleBoton" />
    
    <Button 
            fx:id="btnLimpiar" 
            text="Limpiar" 
            onAction="#limpiar" />
    
    <Label 
            text="Resumen:" />
    
    <Label 
            fx:id="lblResumen" 
            text="Esperando datos de la compra..." />
    
    <Label 
            fx:id="lblMensaje" 
            text="Bienvenido a la cafetería" />

</VBox>