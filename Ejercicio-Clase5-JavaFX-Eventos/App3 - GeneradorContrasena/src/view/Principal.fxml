<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox 
        prefWidth="400" 
        prefHeight="500" 
        spacing="15" 
        alignment="CENTER" 
        style="-fx-padding: 20;" 
        xmlns="http://javafx.com/javafx/21" 
        xmlns:fx="http://javafx.com/fxml/1" 
        fx:controller="controller.PrincipalController">
    
    <Label 
            text="Generador de Contraseñas" />
    
    <Label 
            text="Longitud:" />
    
    <TextField 
            fx:id="txtLongitud" 
            onKeyPressed="#manejarKeyEvent" />
    
    <CheckBox 
            fx:id="chkMayusculas" 
            text="Incluir mayúsculas" />
    
    <CheckBox 
            fx:id="chkNumeros" 
            text="Incluir números" />
    
    <CheckBox 
            fx:id="chkSimbolos" 
            text="Incluir símbolos" />
    
    <HBox 
            spacing="20" 
            alignment="CENTER">
        
        <Button 
                fx:id="btnGenerar" 
                text="Generar" 
                onAction="#generar" 
                onMouseEntered="#mouseEntraBoton" 
                onMouseExited="#mouseSaleBoton" />
        
        <Button 
                fx:id="btnLimpiar" 
                text="Limpiar" 
                onAction="#limpiar" />
    </HBox>
    
    <Label 
            text="Contraseña generada:" />
    
    <Label 
            fx:id="lblContrasena" 
            text="Esperando configuración..." />
    
    <Label 
            fx:id="lblMensaje" 
            text="Bienvenido al generador" />

</VBox>